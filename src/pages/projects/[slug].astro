---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const base = import.meta.env.BASE_URL;
---
<Base title={`${d.title} | 김재표`} description={d.summary}>
  <article class="py-12">
    <a href={`${base}#projects`} class="text-sm text-slate-500 hover:text-slate-900">← 프로젝트 목록</a>
    <h1 class="mt-4 text-3xl font-bold text-slate-900">{d.title}</h1>
    <p class="mt-2 text-lg text-slate-600">{d.summary}</p>

    <dl class="mt-6 grid gap-3 rounded-xl border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2">
      <div><dt class="text-slate-500">기간</dt><dd class="font-medium">{d.period}</dd></div>
      <div><dt class="text-slate-500">팀</dt><dd class="font-medium">{d.team}</dd></div>
      <div class="sm:col-span-2"><dt class="text-slate-500">맡은 일</dt><dd class="font-medium">{d.role}</dd></div>
      <div class="sm:col-span-2">
        <dt class="text-slate-500">기술</dt>
        <dd class="mt-1 flex flex-wrap gap-2">{d.tags.map((t) => <span class="rounded-md bg-slate-100 px-2 py-1 text-xs">{t}</span>)}</dd>
      </div>
      {d.badge && <div class="sm:col-span-2"><dt class="text-slate-500">구분</dt><dd class="font-medium">{d.badge}</dd></div>}
    </dl>

    <div class="prose-content mt-8">
      <Content />
    </div>

    {(d.github || d.video) && (
      <div class="mt-8 flex gap-3">
        {d.github && <a href={d.github} class="rounded-lg bg-slate-900 px-4 py-2 text-sm text-white">코드 보기</a>}
        {d.video && <a href={d.video} class="rounded-lg border border-slate-300 px-4 py-2 text-sm">동작 영상</a>}
      </div>
    )}
  </article>
</Base>

<style is:global>
  .prose-content h2 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-top: 2rem; margin-bottom: 0.75rem; }
  .prose-content p { line-height: 1.75; margin-top: 0.75rem; }
  .prose-content ul, .prose-content ol { margin-top: 0.75rem; padding-left: 1.25rem; line-height: 1.75; }
  .prose-content ul { list-style: disc; }
  .prose-content ol { list-style: decimal; }
  .prose-content code { background: #f1f5f9; padding: 0.1rem 0.3rem; border-radius: 0.25rem; font-size: 0.9em; }
  .prose-content pre { background: #0f172a; color: #e2e8f0; padding: 1rem; border-radius: 0.75rem; overflow-x: auto; margin-top: 0.75rem; }
  .prose-content pre code { background: none; padding: 0; }
  .prose-content table { width: 100%; margin-top: 0.75rem; border-collapse: collapse; font-size: 0.9rem; }
  .prose-content th, .prose-content td { border: 1px solid #e2e8f0; padding: 0.5rem; text-align: left; }
</style>
