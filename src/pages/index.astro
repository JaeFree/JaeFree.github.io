---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { profile, contact, about, certifications, skills, games } from '../data/profile';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);
const base = import.meta.env.BASE_URL;

const levels = ['사용만 해봤음', '간단한 기능을 구현할 수 있음', '프로젝트에 활용할 수 있음', '능숙하게 다룸', '깊이 이해하고 있음'];
const hasLevels = skills.some((g) => g.items.some((i) => i.level));
const contactCount = [contact.github, contact.email, contact.phone].filter(Boolean).length;
---
<Base title={`${profile.name} | Portfolio`}>
  <!-- 첫 화면 -->
  <section id="home" class="hero-bg text-white">
    <div class="mx-auto grid min-h-[calc(100svh-4rem)] max-w-6xl items-center gap-12 px-4 py-16 sm:min-h-[calc(100svh-5rem)] sm:px-6 md:grid-cols-[auto_1fr] md:gap-16">
      <figure class="mx-auto">
        <p class="eyebrow mb-3 text-center">Player 01</p>
        <div class="hud-corners p-3">
          <img
            src={`${base}${profile.photo}`}
            alt={`${profile.name} 증명사진`}
            width="132"
            height="170"
            class="w-44 bg-white object-cover sm:w-56"
            style="aspect-ratio: 132 / 170"
          />
        </div>
      </figure>
      <div class="text-center md:text-left">
        <p class="eyebrow">// Select your character</p>
        <h1 class="mt-4 text-5xl font-extrabold tracking-tight sm:text-7xl">{profile.name}<span class="text-accent">.</span></h1>
        <p class="mt-4 text-xl font-bold text-white/90 sm:text-2xl">{profile.title}</p>
        <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg md:mx-0">{profile.tagline}</p>

        <dl class="hud-panel mx-auto mt-8 max-w-xl text-left md:mx-0">
          {profile.hud.map((h) => (
            <div class="grid grid-cols-[4.5rem_1fr] gap-3 py-2">
              <dt class="text-accent" style="font-family:var(--font-mono)">{h.label}</dt>
              <dd class="font-semibold text-white/90">{h.value}</dd>
            </div>
          ))}
        </dl>

        <div class="mt-9 flex flex-wrap justify-center gap-3 md:justify-start">
          <a href="#projects" class="btn-game btn-game-accent">▶ 프로젝트 보기</a>
          <a href="#contact" class="btn-game btn-game-ghost">연락하기</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 자기소개 -->
  <section id="about" class="bg-paper-2">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[01] Player Info</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">저를 소개합니다</h2>
      <p class="mt-10 max-w-4xl text-[17px] leading-[1.95] text-ink/85">{about.intro}</p>

      {about.values.length > 0 ? (
        <ol class="mt-14 border-t border-line">
          {about.values.map((v, i) => (
            <li class="flex gap-6 border-b border-line py-8 sm:gap-10">
              <span class="w-10 shrink-0 text-2xl font-extrabold text-accent" style="font-family:var(--font-mono)">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-bold">{v.title}</h3>
                <p class="mt-2 leading-relaxed text-muted">{v.text}</p>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty mt-14">나를 설명하는 키워드를 준비하고 있습니다.</p>
      )}
    </div>
  </section>

  <!-- 해본 게임 -->
  <section id="games">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[02] Play History</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">해본 게임</h2>

      {games.length > 0 ? (
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {games.map((g) => (
            <div class="card card-hover p-6">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-bold">{g.name}</h3>
                {g.genre && <span class="tag shrink-0">{g.genre}</span>}
              </div>
              {g.period && <p class="mt-1 text-sm text-muted">{g.period}</p>}
              {g.record && <p class="mt-4 text-[15px] font-semibold">{g.record}</p>}
              {g.note && <p class="mt-1 text-sm leading-relaxed text-muted">{g.note}</p>}
            </div>
          ))}
        </div>
      ) : (
        <p class="empty mt-12">플레이해 온 게임 목록을 정리하고 있습니다.</p>
      )}
    </div>
  </section>

  <!-- 다루는 기술 및 툴 -->
  <section id="skills" class="border-t border-line">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[03] Skill Tree</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">다루는 기술 및 툴</h2>

      <div class="mt-12 grid gap-5 md:grid-cols-2">
        {skills.map((g) => (
          <div class="card p-6">
            <h3 class="flex items-center gap-2 font-bold"><span class="h-2 w-2 rounded-full bg-accent"></span>{g.group}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {g.items.map((s) => <span class="tag">{s.name}</span>)}
            </div>
            {g.items.some((s) => s.level) && (
              <ul class="mt-5 space-y-3 border-t border-line pt-5">
                {g.items.filter((s) => s.level).map((s) => (
                  <li class="grid grid-cols-[7.5rem_1fr_2.25rem] items-center gap-3 text-sm">
                    <span class="font-semibold">{s.name}</span>
                    <span class="gauge">
                      {[1, 2, 3, 4, 5].map((n) => <span class={n <= s.level! ? 'on' : ''}></span>)}
                    </span>
                    <span class="text-right text-muted">{s.level}/5</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>

      {hasLevels && (
        <div class="mt-8">
          <p class="text-sm font-bold text-muted">레벨 안내</p>
          <ol class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
            {levels.map((l, i) => (
              <li class="flex items-center gap-2">
                <span class="grid h-5 w-5 place-items-center rounded-full bg-accent text-[11px] font-bold text-white">{i + 1}</span>{l}
              </li>
            ))}
          </ol>
        </div>
      )}
    </div>
  </section>

  <!-- 프로젝트 -->
  <section id="projects" class="bg-paper-2">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[04] Quest Log</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">프로젝트</h2>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {projects.map((p, i) => (
          <article class="card card-hover flex flex-col p-6">
            <div class="flex items-center justify-between text-sm text-muted">
              <span class="font-bold text-faint" style="font-family:var(--font-mono)">Q.{String(i + 1).padStart(2, '0')}</span>
              {p.data.period.includes('진행') ? <span class="status status-live">IN PROGRESS</span> : <span class="status">CLEAR</span>}
            </div>
            <h3 class="mt-3 text-lg font-bold leading-snug">{p.data.title}</h3>
            <p class="mt-1 text-sm text-muted">{p.data.period}</p>
            {p.data.badge && <p class="mt-3"><span class="rounded-md bg-accent-soft px-2 py-1 text-xs font-semibold text-accent">{p.data.badge}</span></p>}
            <div class="my-5 border-t border-line"></div>
            <p class="leading-relaxed text-ink/75">{p.data.summary}</p>
            <p class="mt-4 text-sm"><span class="font-bold">맡은 일</span> <span class="text-ink/75">{p.data.role}</span></p>
            <div class="mt-auto">
              <div class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
                {p.data.tags.slice(0, 6).map((t) => <span class="tag">{t}</span>)}
              </div>
              <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-5">
                <a href={`${base}projects/${p.id}/`} class="pill pill-dark">자세히 보기 →</a>
                {p.data.github && <a href={p.data.github} class="pill pill-light">GitHub →</a>}
                {p.data.video && <a href={p.data.video} class="pill pill-light">영상 →</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 자격증 -->
  <section id="certifications" class="border-t border-line">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[05] Achievements</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">자격증</h2>

      {certifications.main.length > 0 && (
        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          {certifications.main.map((c) => (
            <div class="card p-6">
              <div class="flex items-start justify-between">
                <span class="grid h-10 w-10 place-items-center rounded-full bg-accent-soft text-accent">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6" /><path d="M15.5 13 17 22l-5-3-5 3 1.5-9" /></svg>
                </span>
                {c.status && <span class="tag">{c.status}</span>}
              </div>
              <h3 class="mt-5 font-bold">{c.name}</h3>
              <p class="mt-1 text-sm text-muted">{c.issuer}{c.date && ` · ${c.date}`}</p>
            </div>
          ))}
        </div>
      )}

      {certifications.others.length > 0 && (
        <div class="mt-12">
          <h3 class="text-sm font-bold text-muted">기타 자격증</h3>
          <ul class="mt-3">
            {certifications.others.map((c) => (
              <li class="grid grid-cols-[5.5rem_1fr] gap-x-4 gap-y-1 border-b border-line py-3.5 text-[15px] sm:grid-cols-[7rem_1fr_auto]">
                <span class="text-muted">{c.date}</span>
                <span class="font-semibold">{c.name}</span>
                <span class="col-start-2 text-sm text-muted sm:col-start-auto">{c.issuer}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {certifications.main.length + certifications.others.length === 0 && (
        <p class="empty mt-12">취득한 자격증을 정리하고 있습니다.</p>
      )}
    </div>
  </section>

  <!-- 연락처 -->
  <section id="contact" class="hero-bg text-white">
    <div class="reveal mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <p class="eyebrow">[06] Contact</p>
      <h2 class="mt-3 text-3xl font-extrabold tracking-tight sm:text-4xl">연락처</h2>
      {contactCount > 0 && (
        <ul class="mt-12 grid gap-3 sm:grid-cols-3">
          {contact.email && (
            <li><a href={`mailto:${contact.email}`} class="contact-link"><span class="eyebrow">Email</span><span class="mt-2 block font-semibold break-all">{contact.email}</span></a></li>
          )}
          {contact.github && (
            <li><a href={contact.github} class="contact-link"><span class="eyebrow">GitHub</span><span class="mt-2 block font-semibold">{contact.github.replace('https://', '')}</span></a></li>
          )}
          {contact.phone && (
            <li><a href={`tel:${contact.phone.replace(/[^0-9+]/g, '')}`} class="contact-link"><span class="eyebrow">Phone</span><span class="mt-2 block font-semibold">{contact.phone}</span></a></li>
          )}
        </ul>
      )}
    </div>
  </section>
</Base>
